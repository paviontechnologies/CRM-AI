{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022"],
    // Workers runtime globals (R2Bucket, RateLimit, ExecutionContext, …) plus
    // @types/node for the `node:`-prefixed modules that nodejs_compat provides
    // at runtime (node:crypto, node:async_hooks). Order matters: workers-types
    // comes last so its globals win where the two overlap.
    "types": ["node", "@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "prisma/seed.ts"]
}
