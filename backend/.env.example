# Neon Postgres — pooled connection string
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Neon direct (non-pooled) string — used by prisma migrate; set same as DATABASE_URL if you only have one
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

JWT_SECRET="change_me_to_a_long_random_string"
PORT=5001
FRONTEND_URL=http://localhost:3000

# Optional — AI features fall back to mock data without it
ANTHROPIC_API_KEY=

# Optional — emails log to console without SMTP
SMTP_HOST=hkag dhqv wpua qzwh
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional — Google sign-in returns 501 without it
GOOGLE_CLIENT_ID=

# Campaign scheduler
CAMPAIGN_TICK_MS=60000
# One "day" of a sequence step, in ms. Lower it (e.g. 60000) to smoke-test sequences fast.
CAMPAIGN_DAY_MS=86400000

# File uploads
UPLOAD_DIR=uploads
