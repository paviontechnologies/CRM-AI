# Local development only (`wrangler dev` reads this file).
# In production these are Cloudflare secrets/vars — see scripts/setup-cloudflare.sh.
# Secrets:  npx wrangler secret put <NAME>
# Plain vars live in wrangler.jsonc under "vars".

# ─── Required ────────────────────────────────────────────────────────────────
# Neon Postgres — pooled connection string (the Workers driver adapter uses it)
DATABASE_URL="postgresql://neondb_owner:npg_fw5c8rpeCozH@ep-lingering-fog-aytqv0fm.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Neon direct (non-pooled) string — used by `prisma migrate`, not by the Worker
DIRECT_URL="postgresql://neondb_owner:npg_fw5c8rpeCozH@ep-lingering-fog-aytqv0fm.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Long random string. CHANGE THIS before deploying.
JWT_SECRET="change_me_to_a_long_random_string"

# ─── Origins ─────────────────────────────────────────────────────────────────
# Drives CORS. Must be the real frontend origin in production.
FRONTEND_URL=http://localhost:3000
# Public base URL of THIS API — used to build campaign open-tracking pixel links.
PUBLIC_API_URL=http://localhost:8787

# ─── AI (Anthropic Claude) ───────────────────────────────────────────────────
# Powers lead scoring, outreach drafting, lead suggestions AND the action-capable
# AI assistant. Without it those features return mock data.
ANTHROPIC_API_KEY=

# ─── Email (Resend) — optional; emails log to the console when unset ─────────
# SMTP needs a raw TCP socket, which Workers does not provide, so delivery goes
# through Resend's HTTPS API instead. https://resend.com
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=Your Company

# ─── Inbound email replies — optional; the webhook returns 503 without it ─────
# Shared secret your provider (SendGrid Inbound Parse, Mailgun, Postmark…) must
# send as the x-webhook-secret header when POSTing to
# /api/webhooks/inbound-email. Replies drive reply-rate analytics and stop the
# drip sequence for that lead.
INBOUND_WEBHOOK_SECRET=


# ─── Campaign scheduler ──────────────────────────────────────────────────────
# The sequence engine runs on the cron trigger in wrangler.jsonc (every minute).
# One "day" of a sequence step, in ms. Lower it (e.g. 60000) to smoke-test fast.
CAMPAIGN_DAY_MS=86400000
CAMPAIGN_BATCH_SIZE=25
# Set to "off" to stop the scheduler from sending.
CAMPAIGN_SCHEDULER=

# ─── File uploads (R2) ───────────────────────────────────────────────────────
# The bucket itself is bound in wrangler.jsonc as ATTACHMENTS.
MAX_UPLOAD_BYTES=10485760

# ─── Local dev login bypass ──────────────────────────────────────────────────
# 'true' exposes POST /api/auth/dev-login, which signs into the demo workspace
# (demo@demo.com) with no credentials, creating it if absent. The route 404s
# when this is unset. NEVER set it in a deployed environment.
DEV_AUTH_BYPASS=

# ─── Supabase Auth (identity provider) ───────────────────────────────────────
# Supabase owns signup, sign-in, password resets and OAuth. Tokens are signed
# with the project's asymmetric key, so this Worker verifies them against the
# public JWKS — no secret required, just the project URL.
SUPABASE_URL=
