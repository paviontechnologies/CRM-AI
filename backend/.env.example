# ─── Required ────────────────────────────────────────────────────────────────
# Neon Postgres — pooled connection string
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Neon direct (non-pooled) string — used by prisma migrate; set same as DATABASE_URL if you only have one
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Long random string. CHANGE THIS before deploying.
JWT_SECRET="change_me_to_a_long_random_string"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5001
FRONTEND_URL=http://localhost:3000
# Public base URL of THIS API — used to build campaign open-tracking pixel links.
# Set this to your deployed API origin in production.
PUBLIC_API_URL=http://localhost:5001

# ─── AI (Anthropic Claude) ───────────────────────────────────────────────────
# Powers lead scoring, outreach drafting, lead generation AND the action-capable
# AI assistant. Without it, those features return mock data / a "not configured" note.
ANTHROPIC_API_KEY=

# ─── Email (SMTP) — optional; emails log to the console when unset ────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.com
SMTP_FROM_NAME=Your Company

# ─── Google sign-in — optional; /api/auth/google returns 501 without it ───────
GOOGLE_CLIENT_ID=

# ─── Stripe billing — optional; checkout returns a mock URL without it ────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_GROWTH_PRICE_ID=
STRIPE_AGENCY_PRICE_ID=

# ─── Campaign scheduler ──────────────────────────────────────────────────────
CAMPAIGN_TICK_MS=60000
# One "day" of a sequence step, in ms. Lower it (e.g. 60000) to smoke-test sequences fast.
CAMPAIGN_DAY_MS=86400000
CAMPAIGN_BATCH_SIZE=25
# Set to "off" to disable the scheduler on replicas that shouldn't send.
CAMPAIGN_SCHEDULER=

# ─── File uploads ────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760
